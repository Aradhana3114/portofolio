# Template. Salin ke .env.local lalu isi nilainya sendiri:
#   cp .env.local.example .env.local
#
# JANGAN pernah menaruh nilai asli di file ini. File ini tracked di git dan
# repo ini publik, jadi apa pun yang ditulis di sini akan bisa dibaca siapa saja.
# (.gitignore tidak menolong: aturan hanya berlaku untuk file yang belum tracked.)

# --- Supabase (aman dipublikasikan) ---
# sb_publishable_ memang dirancang masuk browser, jadi boleh ada di sini.
NEXT_PUBLIC_SUPABASE_URL=https://nrhdmsbktezxfnmxrnfd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pHcVZBujIn_utxa0djgEOw_00lMQpew

# --- Guestbook admin (server-only) ---
# Untuk halaman /[locale]/admin/guestbook: balas, ubah, hapus pesan.
#
# ADMIN_PASSCODE
#   Passcode untuk masuk ke halaman admin. Buatkan yang panjang & acak.
#   Disimpan di localStorage browser setelah login.
#
# SUPABASE_SERVICE_ROLE_KEY
#   Supabase Dashboard > Project Settings > API Keys > "service_role".
#   Key ini MELWALUI RLS: siapa pun yang memilikinya bisa baca, tulis, dan hapus
#   semua tabel di project Supabase ini. Karena itu nilainya TIDAK BOLEH diberi
#   prefix NEXT_PUBLIC_ dan hanya boleh dibaca di server.
#
# Di Vercel, set keduanya di Settings > Environment Variables untuk
# Production, Preview, dan Development. Tanpa itu, /admin/guestbook akan
# menampilkan "Admin belum dikonfigurasi" padahal deploy-nya sukses.
ADMIN_PASSCODE=
SUPABASE_SERVICE_ROLE_KEY=

# --- Formspree (server-only) ---
# Form ID dari endpoint form Anda: https://formspree.io/f/<FORM_ID>
# Cara mendapatkannya: https://formspree.io > buka form > salin Form ID.
# Dibaca oleh POST /api/contact untuk meneruskan pesan ke Formspree
# (email notifikasi + dashboard submissions). Tanpa ini, submit form akan
# mengembalikan error "Formspree is not configured".
#
# Di Vercel, set juga di Settings > Environment Variables (Production,
# Preview, Development) lalu redeploy.
FORMSPREE_ID=

# --- Gmail SMTP (server-only) — email notifikasi terdesain ---
# Dibaca POST /api/contact untuk mengirim email notifikasi bergaya tema
# portfolio (kartu brutal, kuning/pink/green) ke inbox Anda, BERBARENGAN
# dengan email polos Formspree. Jika kosong, fitur ini dilewati otomatis
# dan form tetap jalan (hanya email Formspree yang masuk).
#
# GMAIL_USER
#   Alamat Gmail yang mengirim notifikasi sekaligus penerimanya.
#
# GMAIL_APP_PASSWORD (16 karakter, BUKAN password Gmail biasa)
#   1. Buka https://myaccount.google.com > Keamanan
#   2. Aktifkan "Verifikasi 2 Langkah" (wajib, jika belum)
#   3. Buka https://myaccount.google.com/apppasswords
#   4. Beri nama bebas (mis. "Portfolio") > Buat > salin 16 karakter
#   5. Isi di sini DAN di Vercel > Settings > Environment Variables
GMAIL_USER=
GMAIL_APP_PASSWORD=
