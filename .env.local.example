# Template. Salin ke .env.local lalu isi nilainya sendiri:
#   cp .env.local.example .env.local
#
# JANGAN pernah menaruh nilai asli di file ini. File ini tracked di git dan
# repo ini publik, jadi apa pun yang ditulis di sini akan bisa dibaca siapa saja.
# (.gitignore tidak menolong: aturan hanya berlaku untuk file yang belum tracked.)

# --- Supabase (aman dipublikasikan) ---
# sb_publishable_ memang dirancang masuk browser, jadi boleh ada di sini.
NEXT_PUBLIC_SUPABASE_URL=https://nrhdmsbktezxfnmxrnfd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pHcVZBujIn_utxa0djgEOw_00lMQpew

# --- Guestbook admin (server-only) ---
# Untuk halaman /[locale]/admin/guestbook: balas, ubah, hapus pesan.
#
# ADMIN_PASSCODE
#   Passcode untuk masuk ke halaman admin. Buatkan yang panjang & acak.
#   Disimpan di localStorage browser setelah login.
#
# SUPABASE_SERVICE_ROLE_KEY
#   Supabase Dashboard > Project Settings > API Keys > "service_role".
#   Key ini MELWALUI RLS: siapa pun yang memilikinya bisa baca, tulis, dan hapus
#   semua tabel di project Supabase ini. Karena itu nilainya TIDAK BOLEH diberi
#   prefix NEXT_PUBLIC_ dan hanya boleh dibaca di server.
#
# Di Vercel, set keduanya di Settings > Environment Variables untuk
# Production, Preview, dan Development. Tanpa itu, /admin/guestbook akan
# menampilkan "Admin belum dikonfigurasi" padahal deploy-nya sukses.
ADMIN_PASSCODE=
SUPABASE_SERVICE_ROLE_KEY=
